<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base application theme. -->
    <style name="Theme.Moolreandroidsdk" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>

        <!-- Error colors -->
        <item name="colorError">@color/design_default_color_error</item>
        <item name="colorOnError">@color/white</item>

        <!-- Status bar color. -->
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>

        <!-- Default TextAppearances that views use by default -->
        <item name="textAppearanceSubtitle1">@style/TextAppearance.Moolre.Subtitle1</item>
        <item name="textAppearanceBody1">@style/TextAppearance.Moolre.Body1</item>
        <!-- Add other global overrides here if needed -->
    </style>

    <!-- TEXT APPEARANCE DEFINITIONS -->
    <style name="TextAppearance.Moolre.Subtitle1" parent="TextAppearance.MaterialComponents.Subtitle1">
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>
    <style name="TextAppearance.Moolre.Body1" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>
    <!-- ... other base text appearances like Headline5, Headline6, Button, Caption etc. can go here ... -->

    <style name="TextAppearance.Moolre.ListItem" parent="TextAppearance.Moolre.Subtitle1">
        <!-- Specifics for list item, inherits color from Subtitle1 -->
    </style>

    <style name="TextAppearance.Moolre.ListItem.Price" parent="TextAppearance.Moolre.ListItem">
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Specific theme for MainActivity if needed -->
    <style name="Theme.Moolreandroidsdk.MainActivity" parent="Theme.Moolreandroidsdk">
        <!-- Overrides specific to MainActivity -->
    </style>
</resources>
